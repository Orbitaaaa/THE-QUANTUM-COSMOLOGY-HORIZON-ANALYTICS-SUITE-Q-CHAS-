  },
  "transient connected daughter": {
   "allowed": true,
   "verdict": "allowed by the GSL: transient, dependent daughter (neck never closes, Lambda_final <= Lambda_parent)",
   "premise": "none violated"
  },
  "crunching daughter": {
   "allowed": true,
   "verdict": "the GSL (causal horizons of complete observers) does not constrain this daughter; its formation still needs NEC violation along ingoing rays (Farhi-Guth), priced by Theorem GSL-4",

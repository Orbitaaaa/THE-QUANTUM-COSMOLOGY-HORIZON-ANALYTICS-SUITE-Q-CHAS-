  },
  "daughter beyond a Cauchy horizon": {
   "allowed": true,
   "verdict": "not excluded by the GSL; the daughter lies beyond the Cauchy horizon of Sigma_0 and is not determined by the laboratory data (escape E2)",
   "premise": "global hyperbolicity"
  },
  "dS parent, Lambda_d < Lambda_p": {
   "allowed": true,
   "verdict": "allowed by the GSL: transient, dependent daughter (neck never closes, Lambda_final <= Lambda_parent)",
   "premise": "none violated"
  },
  "dS parent, Lambda_d > Lambda_p": {
   "allowed": false,
   "verdict": "excluded: the GSL on the observer's horizon needs A_daughter >= A_parent (Corollary GSL-3b)",
   "premise": "global hyperbolicity + GSL"
  }
